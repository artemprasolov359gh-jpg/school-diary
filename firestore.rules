rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "PASTE_ADMIN_UID_HERE";
    }
    match /weeklySchedule/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["weekday","subject","start","end","createdAt"])
        && request.resource.data.weekday is int
        && request.resource.data.weekday >= 0 && request.resource.data.weekday <= 6
        && request.resource.data.subject is string
        && request.resource.data.start is string
        && request.resource.data.end is string;
      allow delete: if isAdmin();
    }
    match /homework/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["date","subject","text","createdAt"])
        && request.resource.data.date is string
        && request.resource.data.subject is string
        && request.resource.data.text is string;
      allow delete: if isAdmin();
    }
  }
}
